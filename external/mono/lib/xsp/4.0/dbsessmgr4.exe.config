<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
	<add key="DBProviderAssembly"
	     value="Npgsql"/>
	<add key="DBConnectionType"
	     value="Npgsql.NpgsqlConnection"/>
	<!-- Archura: database session setup is disabled in this vendor sample.
	     Supply DBConnectionString in a private local configuration before use. -->
    </appSettings>
</configuration>

